# Để trống = SQLite, file backend/wms.db (không cần cài MySQL, tự tạo bảng khi chạy).
# Muốn dùng MySQL: đặt URL, ví dụ mysql+pymysql://wms:change_me@localhost:3306/wms?charset=utf8mb4
DATABASE_URL=
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=change_me
MQTT_TLS=false
MQTT_CA_FILE=
# none = không đụng broker (dev). dynsec = tạo/xóa tài khoản thiết bị qua Mosquitto Dynamic Security
BROKER_ADMIN=none
# Khóa ký JWT, >= 32 ký tự. Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Schema do database/migrations tạo. Chỉ đặt true khi dev với DB rỗng và tài khoản có quyền CREATE.
AUTO_CREATE_TABLES=false
# Origin được phép mở WebSocket (cách nhau bằng dấu phẩy), ví dụ https://dashboard.example.vn. Rỗng = không kiểm tra.
WS_ALLOWED_ORIGINS=
